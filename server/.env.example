# ─────────────────────────────────────────────
#  Oasis TimeMark — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# CORS — set to your frontend URL in production
FRONTEND_URL=http://localhost:5500

# LocationIQ (free tier)
LOCATIONIQ_API_KEY=your-locationiq-api-key-here

# Admin setup — used ONCE to create the first admin account via POST /api/auth/admin/register
# Change this to a strong random string and keep it secret.
ADMIN_SETUP_KEY=change-this-to-a-random-secret-string
